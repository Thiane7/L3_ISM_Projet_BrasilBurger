@model List<brasil_burger.Models.CartItem>

<div class="container mt-5">
    <h2 class="fw-bold mb-4">Votre Panier</h2>

    @if (Model.Count == 0) {
        <div class="alert alert-info">Votre panier est vide. <a href="/">Retour au catalogue</a></div>
    } else {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th>Prix</th>
                    <th>Quantité</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td>
                            <img src="/img/vrai_image/@item.Image" width="50" class="rounded me-2">
                            @item.Nom
                        </td>
                        <td>@item.Prix €</td>
                        <td>@item.Quantite</td>
                        <td>@(item.Total) €</td>
                        <td>
                            <a asp-action="Remove" asp-route-id="@item.Id" asp-route-type="@item.Type" class="text-danger">Supprimer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end mt-4">
            <h4 class="fw-bold">Total : @Model.Sum(x => x.Total) €</h4>
            <button class="btn btn-warning btn-lg fw-bold px-5 rounded-pill">Commander</button>
        </div>
    }
</div>