@model brasil_burger.Models.CatalogueViewModel

<div class="container mt-4">
    @* --- FILTRES --- *@
    <div class="d-flex justify-content-start gap-4 mb-5 border-bottom pb-2">
        <button class="btn-filter active" onclick="filterCategory('all', this)">Tous</button>
        <button class="btn-filter" onclick="filterCategory('Menu', this)">Menus</button>
        <button class="btn-filter" onclick="filterCategory('Burger', this)">Burgers</button>
        <button class="btn-filter" onclick="filterCategory('Complement', this)">Compléments</button>
    </div>

    <div class="row" id="catalogue-container">
        
        @* --- SECTION BURGERS --- *@
        @foreach (var burger in Model.Burgers)
        {
            <div class="col-md-4 mb-4 product-item" data-category="Burger">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                    @* Image agrandie à 280px *@
                    <div style="height: 280px; width: 100%; overflow: hidden; background-color: #f8f9fa;">
                        <img src="~/images/@burger.Image" class="w-100 h-100" alt="@burger.Nom" style="object-fit: cover; object-position: center;">
                    </div>
                    <div class="card-body text-center">
                        <h5 class="fw-bold">@burger.Nom</h5>
                        <p class="text-orange fw-bold fs-5">@burger.Prix FCFA</p>
                        <button class="btn btn-orange w-100 rounded-3 py-2 fw-bold" data-bs-toggle="modal" data-bs-target="#modal-burger-@burger.Id">
                            Voir détails & Ajouter
                        </button>
                    </div>
                </div>
            </div>

            @* Modal de personnalisation Burger *@
            <div class="modal fade" id="modal-burger-@burger.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content rounded-4 border-0">
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="id" value="@burger.Id" />
                            <input type="hidden" name="nom" value="@burger.Nom" />
                            <input type="hidden" name="prix" value="@burger.Prix" />
                            <input type="hidden" name="image" value="@burger.Image" />
                            <input type="hidden" name="type" value="Burger" />
                            <input type="hidden" name="extraPrix" class="extra-prix-input" value="0" />

                            <div class="modal-body p-4">
                                <h5 class="fw-bold mb-3">@burger.Nom</h5>
                                <p class="text-muted small">Personnalisez votre burger avec nos compléments frais.</p>
                                
                                <div class="bg-light p-3 rounded-3 mb-4 d-flex justify-content-between align-items-center">
                                    <span class="fw-bold">Prix de base</span>
                                    <span class="text-orange fw-bold base-price" data-price="@burger.Prix">@burger.Prix FCFA</span>
                                </div>

                                <h6 class="fw-bold mb-3">Compléments disponibles</h6>
                                <div class="row g-2">
                                    @foreach (var comp in Model.Complements)
                                    {
                                        <div class="col-6">
                                            <div class="border rounded-3 p-2 d-flex align-items-center">
                                                <div class="form-check w-100">
                                                    <input class="form-check-input complement-check" type="checkbox" name="selectedComplements" value="@comp.Nom" id="comp-b-@burger.Id-@comp.Id" data-price="@comp.Prix">
                                                    <label class="form-check-label small" for="comp-b-@burger.Id-@comp.Id">
                                                        <strong>@comp.Nom</strong> <br> +@comp.Prix F
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                    <span class="fw-bold">Total</span>
                                    <span class="text-orange fw-bold fs-5 total-price-display">@burger.Prix FCFA</span>
                                </div>
                            </div>
                            <div class="modal-footer border-0 p-4 pt-0">
                                <button type="button" class="btn btn-outline-secondary flex-grow-1" data-bs-dismiss="modal">Fermer</button>
                                <button type="submit" class="btn btn-orange flex-grow-1 fw-bold">Ajouter au panier</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* --- SECTION COMPLÉMENTS --- *@
        @foreach (var comp in Model.Complements)
        {
            <div class="col-md-3 mb-4 product-item" data-category="Complement">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden text-center">
                    @* Image des compléments à 200px *@
                    <div style="height: 200px; width: 100%; overflow: hidden; background-color: #f8f9fa;">
                        @if (!string.IsNullOrEmpty(comp.Image))
                        {
                            <img src="~/images/@comp.Image" class="w-100 h-100" style="object-fit: cover;" alt="@comp.Nom">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100">
                                <i class="bi bi-plus-circle text-orange fs-1"></i>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        <h6 class="fw-bold">@comp.Nom</h6>
                        <p class="text-orange fw-bold">@comp.Prix FCFA</p>
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="id" value="@comp.Id" />
                            <input type="hidden" name="nom" value="@comp.Nom" />
                            <input type="hidden" name="prix" value="@comp.Prix" />
                            <input type="hidden" name="image" value="@comp.Image" />
                            <input type="hidden" name="type" value="Complement" />
                            <button type="submit" class="btn btn-sm btn-outline-orange w-100 rounded-pill fw-bold">+ Ajouter</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @* --- SECTION MENUS --- *@
        @foreach (var menu in Model.Menus)
        {
            <div class="col-md-4 mb-4 product-item" data-category="Menu">
                <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">
                    @* Image des menus à 280px *@
                    <div style="height: 280px; width: 100%; overflow: hidden; background-color: #f8f9fa;">
                        <img src="~/images/@menu.Image" class="w-100 h-100" alt="@menu.Nom" style="object-fit: cover; object-position: center;">
                    </div>
                    <div class="card-body text-center">
                        <h5 class="fw-bold">@menu.Nom (Menu)</h5>
                        <p class="text-orange fw-bold fs-5">@menu.Prix FCFA</p>
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="id" value="@menu.Id" />
                            <input type="hidden" name="nom" value="@menu.Nom" />
                            <input type="hidden" name="prix" value="@menu.Prix" />
                            <input type="hidden" name="type" value="Menu" />
                            <button type="submit" class="btn btn-orange w-100 rounded-3 py-2 fw-bold">Ajouter le Menu</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .btn-filter { border: none; background: none; font-weight: bold; color: #6c757d; padding-bottom: 8px; transition: 0.3s; }
    .btn-filter.active { color: #FF6B00; border-bottom: 3px solid #FF6B00; }
    .text-orange { color: #FF6B00; }
    .btn-orange { background-color: #FF6B00; color: white; border: none; }
    .btn-orange:hover { background-color: #e66000; color: white; }
    .btn-outline-orange { border: 2px solid #FF6B00; color: #FF6B00; }
    .btn-outline-orange:hover { background-color: #FF6B00; color: white; }
</style>

@section Scripts {
<script>
    function filterCategory(category, element) {
        document.querySelectorAll('.btn-filter').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
        const items = document.querySelectorAll('.product-item');
        items.forEach(item => {
            if (category === 'all' || item.getAttribute('data-category') === category) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const modals = document.querySelectorAll('.modal');
        modals.forEach(modal => {
            const checkboxes = modal.querySelectorAll('.complement-check');
            const totalPriceDisplay = modal.querySelector('.total-price-display');
            const extraPrixInput = modal.querySelector('.extra-prix-input');
            const basePriceElement = modal.querySelector('.base-price');

            if (basePriceElement) {
                const basePrice = parseFloat(basePriceElement.dataset.price);
                checkboxes.forEach(checkbox => {
                    checkbox.addEventListener('change', function () {
                        let extraTotal = 0;
                        modal.querySelectorAll('.complement-check:checked').forEach(checkedBox => {
                            extraTotal += parseFloat(checkedBox.dataset.price);
                        });
                        const finalTotal = basePrice + extraTotal;
                        totalPriceDisplay.innerText = finalTotal + " FCFA";
                        extraPrixInput.value = extraTotal;
                    });
                });
            }
        });
    });
</script>
}