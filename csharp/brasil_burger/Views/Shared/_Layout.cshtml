<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brasil Burger</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/brasil_burger.styles.css" asp-append-version="true" />
    <style>
        .text-orange { color: #FF6B00 !important; }
        .bg-orange { background-color: #FF6B00 !important; }
        .nav-link.active-orange { 
            color: #FF6B00 !important; 
            border-bottom: 3px solid #FF6B00; 
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold text-orange" asp-controller="Catalogue" asp-action="Index">
                    🍔 Brasil Burger
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-center">
                    <ul class="navbar-nav">
                        <li class="nav-item mx-2">
                            <a class="nav-link text-dark fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Catalogue" ? "active-orange" : "")" 
                               asp-controller="Catalogue" asp-action="Index">
                                <i class="bi bi-grid-fill me-1"></i> Catalogue
                            </a>
                        </li>
                        
                        <li class="nav-item mx-2 position-relative">
                            <a class="nav-link text-dark fw-bold @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cart" ? "active-orange" : "")" 
                               asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart-fill me-1"></i> Panier
                                @{
                                    var cartJson = Context.Session.GetString("Cart");
                                    var count = 0;
                                    if (!string.IsNullOrEmpty(cartJson))
                                    {
                                        var cart = System.Text.Json.JsonSerializer.Deserialize<List<brasil_burger.Models.CartItem>>(cartJson);
                                        count = cart?.Count ?? 0;
                                    }
                                }
                                @if (count > 0)
                                {
                                    <span class="badge rounded-pill bg-orange position-absolute top-0 start-100 translate-middle" style="font-size: 0.7rem;">
                                        @count
                                    </span>
                                }
                            </a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link text-dark fw-bold" href="#">
                                <i class="bi bi-box-seam-fill me-1"></i> Mes commandes
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3">
        <div class="container text-center">
            &copy; 2025 - <strong>Brasil Burger</strong> - Commandez vos burgers favoris
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>