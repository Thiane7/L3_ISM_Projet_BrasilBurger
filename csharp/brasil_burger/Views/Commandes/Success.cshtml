@model brasil_burger.Models.Commande

@{
    ViewData["Title"] = "Commande Confirmée";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card shadow-lg border-0 rounded-4 p-5">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                
                <h2 class="fw-bold mb-3">Merci pour votre commande !</h2>
                <p class="text-muted mb-4">
                    Votre paiement a été validé. Votre commande est maintenant en cours de préparation par l'équipe Brasil Burger.
                </p>

                <div class="bg-light rounded-3 p-4 mb-4 text-start">
                    <h5 class="border-bottom pb-2 mb-3 fw-bold">Résumé du reçu</h5>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Numéro de commande :</span>
                        <span class="fw-bold text-dark">#@Model.Id</span>
                    </div>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Date :</span>
                        <span>@Model.DateCommande.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Mode :</span>
                        <span class="badge bg-primary">@Model.ModeConsommation.Replace("_", " ")</span>
                    </div>

                    <div class="d-flex justify-content-between border-top pt-3 mt-2">
                        <span class="fw-bold fs-5">Total payé :</span>
                        <span class="fw-bold fs-5 text-success">@Model.MontantTotal FCFA</span>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <a asp-controller="Catalogue" asp-action="Index" class="btn btn-warning rounded-pill py-2 fw-bold shadow-sm">
                        Continuer mes achats
                    </a>
                    <button onclick="window.print()" class="btn btn-outline-secondary rounded-pill py-2">
                        <i class="bi bi-printer me-2"></i>Imprimer le reçu
                    </button>
                </div>
            </div>
            
            <p class="mt-4 text-muted small">
                Un email de confirmation vous a été envoyé. <br>
                Besoin d'aide ? <a href="#">Contactez notre support</a>.
            </p>
        </div>
    </div>
</div>

<style>
    body { background-color: #f8f9fa; }
    .card { transition: transform 0.3s ease; }
    .btn-warning { background-color: #FFB300; border: none; color: #000; }
    .btn-warning:hover { background-color: #FFA000; }
</style>