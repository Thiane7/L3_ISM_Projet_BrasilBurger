{% extends 'base.html.twig' %}

{% block title %}Gestion des Zones{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-gray-800">Zones de Livraison</h1>
    <a href="{{ path('app_zones_new') }}" class="btn btn-orange">
        <i class="fas fa-plus me-2"></i>Nouvelle Zone
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Nom de la Zone</th>
                    <th>Frais de livraison</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for zone in zones %}
            <tr>
                    {# 1. Remplacer zone.nom par zone.nomZone #}
                    <td class="ps-4 fw-bold text-dark">{{ zone.nomZone }}</td>
                    
                    {# 2. Remplacer zone.frais par zone.prixLivraison #}
                    <td>{{ zone.prixLivraison }} FCFA</td>
                    
                    <td class="text-end pe-4">
                        {# 3. Vérifier que l'ID est bien idZone (c'est le cas dans ton entité) #}
                        <a href="{{ path('app_zones_edit', {'id': zone.idZone}) }}" class="btn btn-sm btn-outline-primary me-2">
                            <i class="fas fa-edit"></i>
                        </a>
                        <form method="post" action="{{ path('app_zones_delete', {'id': zone.idZone}) }}" style="display:inline-block" onsubmit="return confirm('Supprimer cette zone ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ zone.idZone) }}">
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center py-5 text-muted">
                        Aucune zone trouvée. Cliquez sur "Nouvelle Zone" pour commencer.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}