<div class="col-md-4 col-lg-3">
    <div class="card h-100 card-product">
        <img src="{{ asset('uploads/images/' ~ item.image) }}" class="card-img-top" style="height: 180px; object-fit: cover;">
        <div class="card-body">
            <h5 class="card-title h6 mb-1">{{ item.nom }}</h5>
            <p class="text-orange fw-bold" style="color: #ff6b00;">
                {% if item.prix is defined %}{{ item.prix }} FCFA{% endif %}
            </p>
            <div class="d-flex gap-2">
                <a href="#" class="btn btn-sm btn-light w-100 border text-primary">
                    <i class="bi bi-pencil-square"></i> Modifier
                </a>
                <button class="btn btn-sm btn-light w-100 border text-danger">
                    <i class="bi bi-archive"></i> Archiver
                </button>
            </div>
        </div>
    </div>
</div>