{% extends 'base.html.twig' %}

{% block title %}Modifier {{ type }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h2 class="mb-0">Modifier {{ type }} : {{ item.nom }}</h2>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="row">
                            <div class="col-md-8">
                                {{ form_row(form.nom) }}
                                {% if form.prix is defined %}
                                    {{ form_row(form.prix) }}
                                {% endif %}
                                {{ form_row(form.image) }}
                            </div>
                            <div class="col-md-4 text-center">
                                <label>Image actuelle</label>
                                <img src="{{ asset('uploads/images/' ~ item.image) }}" class="img-fluid rounded border d-block mx-auto mt-2 shadow-sm">
                            </div>
                        </div>

                        {% if form.burger is defined %}
                            <div class="alert alert-light border mt-3">
                                <h4 class="h6">Composition du Menu</h4>
                                {{ form_row(form.burger) }}
                                {{ form_row(form.complements) }}
                            </div>
                        {% endif %}

                        <hr>
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('admin_produit_index') }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-warning px-5">Enregistrer les modifications</button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}