
{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    {# Formulaire de filtre conforme à votre image #}
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Client, numéro...">
        </div>
        <div class="col-md-3">
            <select name="etat" class="form-select">
                <option value="Tous">Tous les états</option>
                <option value="EN_COURS">En attente</option>
                <option value="PRET">En préparation</option>
                <option value="TERMINE">Terminée</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="date" class="form-control">
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrer</button>
        </div>
    </form>

    {% for commande in commandes %}
    <div class="card mb-3 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between">
                <h5>#cmd{{ commande.idCommande }} <span class="badge bg-info">{{ commande.statut }}</span></h5>
                <h5 class="text-orange">{{ commande.montantTotal }} FCFA</h5>
            </div>
            <p>Client: {{ commande.client.prenom }} {{ commande.client.nom }} | Tel: {{ commande.client.telephone }}</p>
            <p>Zone: {{ commande.zone ? commande.zone.nomZone : 'Non définie' }}</p>

            <div class="mt-3">
                {% if commande.statut == 'EN_COURS' %}
                    <a href="{{ path('app_admin_commandes_change_status', {id: commande.idCommande, newStatus: 'PRET'}) }}" class="btn btn-primary">Démarrer préparation</a>
                {% elseif commande.statut == 'PRET' %}
                    <a href="{{ path('app_admin_commandes_change_status', {id: commande.idCommande, newStatus: 'TERMINE'}) }}" class="btn btn-success">Marquer terminée</a>
                {% endif %}
                
                {% if commande.statut != 'ANNULE' and commande.statut != 'TERMINE' %}
                    <a href="{{ path('app_admin_commandes_change_status', {id: commande.idCommande, newStatus: 'ANNULE'}) }}" class="btn btn-danger">Annuler</a>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endblock %}