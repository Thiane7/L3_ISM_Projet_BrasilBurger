<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Connexion - Brasil Burger</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --orange-brasil: #ff6b00;
            --orange-gradient-start: #ff6b00;
            --orange-gradient-end: #ff0000;
        }
        body {
            background: linear-gradient(135deg, var(--orange-gradient-start), var(--orange-gradient-end));
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            width: 100%;
            max-width: 450px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            text-align: center;
        }
        .brand-logo {
            width: 80px;
            height: 80px;
            background-color: var(--orange-brasil);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: white;
            font-size: 32px;
        }
        .brand-title {
            color: var(--orange-brasil);
            font-weight: bold;
            margin-bottom: 5px;
        }
        .brand-subtitle {
            color: #6c757d;
            margin-bottom: 30px;
        }
        .auth-toggle {
            display: flex;
            background-color: white;
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 5px;
            margin-bottom: 25px;
        }
        .auth-toggle a {
            flex: 1;
            text-align: center;
            padding: 10px;
            text-decoration: none;
            color: #495057;
            border-radius: 8px;
            transition: all 0.3s;
            font-weight: 500;
        }
        .auth-toggle a.active {
            background-color: #fff5ed;
            color: var(--orange-brasil);
            border: 1px solid var(--orange-brasil);
        }
        .auth-toggle a:hover:not(.active) {
            background-color: #f8f9fa;
        }
        .form-control {
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ced4da;
            margin-bottom: 20px;
        }
        .form-control:focus {
            border-color: var(--orange-brasil);
            box-shadow: 0 0 0 0.2rem rgba(255, 107, 0, 0.25);
        }
        .btn-login {
            background-color: var(--orange-brasil);
            color: white;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: none;
            font-weight: bold;
            font-size: 16px;
            transition: background-color 0.3s;
        }
        .btn-login:hover {
            background-color: #e65100;
        }
        .create-account {
            margin-top: 20px;
            display: block;
            color: var(--orange-brasil);
            text-decoration: none;
            font-weight: 500;
        }
        .create-account:hover {
            text-decoration: underline;
        }
        .form-label {
            text-align: left;
            display: block;
            font-weight: 500;
            color: #495057;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand-logo">
            <i class="fa-solid fa-burger"></i>
        </div>
        <h2 class="brand-title">Brasil Burger</h2>
        <p class="brand-subtitle">Gestion des Commandes</p>

        <div class="auth-toggle">
            <a href="#">
                <i class="fa-regular fa-user me-2"></i>Client
            </a>
            <a href="#" class="active">
                <i class="fa-solid fa-user-tie me-2"></i>Gestionnaire
            </a>
        </div>

        <form action="{{ path('app_login') }}" method="post">
            {% if error %}
                <div class="alert alert-danger text-start">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="mb-3 text-start">
                <label for="inputEmail" class="form-label">Email</label>
                <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="votre@email.com">
            </div>

            <div class="mb-3 text-start">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <input type="password" name="_password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="********">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-login" type="submit">
                Se connecter
            </button>
        </form>

        <a href="{{ path('app_register') }}" class="create-account">Pas de compte ? Créer un compte</a>
    </div>
</body>
</html>
